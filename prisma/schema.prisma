generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Requisition {
  id                  String   @id @default(cuid())
  date                String
  organizationName    String
  department          String
  address             String
  applicantName       String
  applicantDepartment String
  employeeId          String
  branchName          String
  applicantAddress    String
  contact             String
  category            String
  reason              String
  totalAmount         Float    @default(0)
  status              String   @default("Draft")
  createdByEmail      String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items RequisitionItem[]
}

model RequisitionItem {
  id            String   @id @default(cuid())
  requisitionId String
  sl            Int
  equipmentName String
  description   String   @default("")
  qty           Int      @default(0)
  condition     String   @default("")
  approxPrice   Float    @default(0)
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model DropdownOption {
  id        String   @id @default(cuid())
  type      String   // "department", "branch", "address"
  value     String   // The display value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String
  password   String   @default("")
  phone      String   @default("")
  employeeId String   @default("")
  department String   @default("")
  branch     String   @default("")
  role       String   @default("User")  // "Admin", "Manager", "User"
  status     String   @default("Active") // "Active", "Inactive", "Suspended"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
